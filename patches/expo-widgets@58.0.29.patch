@@ -0,0 +1,50 @@
+package expo.modules.widgets
+
+import android.appwidget.AppWidgetManager
+import android.content.Context
+import android.os.Build
+import android.os.Bundle
+import android.util.SizeF
+import androidx.compose.ui.unit.DpSize
+import androidx.compose.ui.unit.dp
+import androidx.core.os.BundleCompat
+import kotlin.math.abs
+
+private val minimumTallHeight = 150.dp
+private const val tallHeightRatio = 0.52f
+
+internal fun widgetSizeClass(size: DpSize) =
+  if (size.height >= minimumTallHeight && size.height >= size.width * tallHeightRatio) "tall" else "compact"
+
+private fun portraitWidgetSize(options: Bundle): DpSize? {
+  val width = options.getInt(AppWidgetManager.OPTION_APPWIDGET_MIN_WIDTH)
+  val height = options.getInt(AppWidgetManager.OPTION_APPWIDGET_MAX_HEIGHT)
+  // The app is portrait-only. Use the exact option nearest the launcher's portrait pair.
+  val exact = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+    BundleCompat.getParcelableArrayList(options, AppWidgetManager.OPTION_APPWIDGET_SIZES, SizeF::class.java)
+      ?.filter { it.width > 0f && it.height > 0f }
+      ?.minByOrNull { abs(it.width - width) + abs(it.height - height) }
+  } else {
+    null
+  }
+  return exact?.let { DpSize(it.width.dp, it.height.dp) }
+    ?: DpSize(width.dp, height.dp).takeIf { width > 0 && height > 0 }
+}
+
+internal fun widgetPreviewSizes(context: Context, name: String): List<Map<String, Any>> {
+  val manager = AppWidgetManager.getInstance(context)
+  val pinned = manager.getAppWidgetIds(widgetProviderComponentName(context, name)).sortedDescending().mapNotNull { id ->
+    portraitWidgetSize(manager.getAppWidgetOptions(id))?.let { id to it }
+  }
+  fun entry(size: DpSize, widgetId: Int? = null) = buildMap<String, Any> {
+    put("size", widgetSizeClass(size))
+    put("width", size.width.value.toDouble())
+    put("height", size.height.value.toDouble())
+    if (widgetId != null) put("widgetId", widgetId)
+  }
+  return pinned.map { (id, size) -> entry(size, id) } + listOf(
+    DpSize(360.dp, 97.dp),
+    DpSize(360.dp, 202.dp)
+  ).filter { fallback -> pinned.none { (_, size) -> widgetSizeClass(size) == widgetSizeClass(fallback) } }
+    .map { entry(it) }
+}
