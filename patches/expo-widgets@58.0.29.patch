@@ -0,0 +1,101 @@
+package expo.modules.widgets
+
+import android.annotation.SuppressLint
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.RectF
+import android.util.Log
+import android.view.View
+import androidx.compose.ui.unit.DpSize
+import androidx.compose.ui.unit.dp
+import androidx.glance.appwidget.ExperimentalGlanceRemoteViewsApi
+import androidx.glance.appwidget.GlanceRemoteViews
+import expo.modules.kotlin.AppContext
+import expo.modules.kotlin.views.ExpoView
+import io.github.expo.peek.emittables.EmittableTree
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.launch
+import kotlin.math.roundToInt
+
+@SuppressLint("RestrictedApi")
+@OptIn(ExperimentalGlanceRemoteViewsApi::class)
+class WidgetPreviewView(context: Context, appContext: AppContext) : ExpoView(context, appContext) {
+  override val shouldUseAndroidLayout = true
+  var widgetName = ""
+  var sampleProps = ""
+  var widthDp = 0f
+  var heightDp = 0f
+  var previewMood = "live"
+  private var rendering: Job? = null
+  private var observing: Job? = null
+  private var bitmap: Bitmap? = null
+  private val scaledBounds = RectF()
+  private val paint = Paint(Paint.FILTER_BITMAP_FLAG)
+
+  override fun dispatchDraw(canvas: Canvas) {
+    super.dispatchDraw(canvas)
+    val image = bitmap ?: return
+    // Render at the launcher size first, then fit the whole result into the app's content column.
+    val scale = minOf(1f, width.toFloat() / image.width, height.toFloat() / image.height)
+    val left = (width - image.width * scale) / 2
+    val top = (height - image.height * scale) / 2
+    scaledBounds.set(left, top, width - left, height - top)
+    canvas.drawBitmap(image, null, scaledBounds, paint)
+  }
+
+  override fun onAttachedToWindow() {
+    super.onAttachedToWindow()
+    observing = CoroutineScope(Dispatchers.Main.immediate).launch {
+      WidgetsUpdater.publication.collect { if (sampleProps.isEmpty()) render() }
+    }
+    if (sampleProps.isNotEmpty()) render()
+  }
+
+  override fun onDetachedFromWindow() {
+    observing?.cancel()
+    rendering?.cancel()
+    super.onDetachedFromWindow()
+  }
+
+  fun render() {
+    rendering?.cancel()
+    if (!isAttachedToWindow || widthDp <= 0 || heightDp <= 0 || widgetName.isEmpty()) return
+    val app = context.applicationContext
+    val size = DpSize(widthDp.dp, heightDp.dp)
+    val density = resources.displayMetrics.density
+    val pixelWidth = (widthDp * density).roundToInt().coerceAtLeast(1)
+    val pixelHeight = (heightDp * density).roundToInt().coerceAtLeast(1)
+    val name = widgetName
+    val sample = sampleProps
+    val mood = previewMood
+    rendering = CoroutineScope(Dispatchers.Main.immediate).launch {
+      try {
+        val layout = WidgetsLayoutRegistry.layout(app, name) ?: return@launch
+        val props = if (sample.isEmpty()) WidgetsUpdater.publishedProps(app, name) else WidgetsJson.parseMap(sample)
+        val root = renderWidgetRoot(app, name, layout, props, size, mood)
+        val views = GlanceRemoteViews().compose(app, size) { EmittableTree(root) }.remoteViews
+        ensureActive()
+        val preview = views.apply(app, this@WidgetPreviewView)
+        preview.measure(
+          View.MeasureSpec.makeMeasureSpec(pixelWidth, View.MeasureSpec.EXACTLY),
+          View.MeasureSpec.makeMeasureSpec(pixelHeight, View.MeasureSpec.EXACTLY)
+        )
+        preview.layout(0, 0, pixelWidth, pixelHeight)
+        bitmap = Bitmap.createBitmap(pixelWidth, pixelHeight, Bitmap.Config.ARGB_8888).also {
+          preview.draw(Canvas(it))
+        }
+        invalidate()
+      } catch (error: CancellationException) {
+        throw error
+      } catch (error: Exception) {
+        Log.w("ExpoWidgets", "Could not render widget preview", error)
+      }
+    }
+  }
+}
