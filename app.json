{
  "expo": {
    "name": "Anki Streak",
    "slug": "anki-streak",
    "version": "1.2.1",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "scheme": "ankistreak",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/app-icon.png",
    "android": {
      "package": "com.ankistreak.anime",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1E24"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "AnkiStreak",
              "displayName": "Anki Streak",
              "description": "Your Anki review streak, activity, and Miku’s mood.",
              "android": {
                "minWidth": 175,
                "minHeight": 63,
                "targetCellWidth": 4,
                "targetCellHeight": 1,
                "resizeMode": "both",
                "initialLayout": "./src/AnkiWidget.tsx"
              }
            }
          ]
        }
      ],
      "./plugins/withLauncherThemes",
      "expo-router",
      "expo-status-bar"
    ]
  }
}
