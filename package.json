{
  "name": "anki-streak",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "effect-tsgo --tsrs-lint oxlint",
    "typecheck": "effect-tsgo tsrs --noEmit && tsrs --noEmit -p scripts/tsconfig.json",
    "check": "bun scripts/check-local.ts",
    "palettes:generate": "bun scripts/generate-character-palettes.ts",
    "lsp:effect": "effect-tsgo tsrs --lsp --stdio",
    "lsp:lint": "effect-tsgo --tsrs-lint oxlint --lsp",
    "lsp:patch-vscode": "effect-tsgo patch --typescript",
    "refs:sync": "bash scripts/sync-agent-sources.sh",
    "extract": "lingui extract --clean --overwrite",
    "compile": "lingui compile --strict --typescript"
  },
  "scriptDescriptions": {
    "lsp:effect": "Run the Effect-aware TypeScript and JavaScript language server over stdio.",
    "lsp:lint": "Run the Oxlint language server for editor diagnostics.",
    "lsp:patch-vscode": "Patch the workspace TypeScript SDK for VS Code. Repeat after reinstalling TypeScript.",
    "refs:sync": "Check out pinned upstream examples into .agent_sources/."
  },
  "dependencies": {
    "@expo/ui": "^58.0.29",
    "@formatjs/intl-getcanonicallocales": "3.4.0",
    "@formatjs/intl-locale": "5.5.0",
    "@formatjs/intl-pluralrules": "7.1.0",
    "@lingui/core": "^6.12.0",
    "@lingui/react": "6.12.0",
    "@shopify/react-native-skia": "2.14.0",
    "@tamagui/config": "3.3.3",
    "@xstate/effect": "1.0.0-beta.2",
    "@xstate/react": "7.0.0-beta.0",
    "effect": "4.1.4",
    "expo": "58.0.26",
    "expo-background-task": "~58.0.13",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "expo-widgets": "58.0.29",
    "lucide-react-native": "^1.76.0",
    "react": "19.3.0",
    "react-native": "^0.88.1",
    "react-native-reanimated": "4.8.0",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "tamagui": "3.3.3",
    "xstate": "6.0.0-beta.3"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.1.0",
    "@effect/tsgo": "0.73.2",
    "@lingui/babel-plugin-lingui-macro": "6.12.0",
    "@lingui/cli": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@oxlint/plugins": "1.94.0",
    "@tamagui/cli": "3.3.3",
    "@types/bun": "1.4.5",
    "@types/react": "^19.3.0",
    "colorjs.io": "0.7.1",
    "oxlint": "1.94.0",
    "sharp": "0.35.5",
    "tla-ts": "0.0.10",
    "tsrs": "7.1.0-beta.tsrs3",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "expo-widgets@58.0.29": "patches/expo-widgets@58.0.29.patch"
  }
}
